# Groq OpenAI-compatible chat endpoint
UPSTREAM_BASE_URL=https://api.groq.com/openai/v1
UPSTREAM_MODEL=openai/gpt-oss-20b
UPSTREAM_API_KEY=

# Local rule detector policy. For the trained transformer, select a threshold
# validated for that checkpoint instead.
BLOCK_THRESHOLD=0.90
REVIEW_THRESHOLD=0.75

# Optional local/Hub model configuration:
# MODEL_PATH=r4ouf-sb44/prompt-firewall-mohamed-fix
# HF_TOKEN=your_huggingface_read_token
